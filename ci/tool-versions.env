# Pinned CI tools: the only place for versions and checksums. All versions are UNVERIFIED.
# Format: <tool> <version> <sha256 of the download>  (space separated, not shell syntax)
# Get a URL with: bash scripts/ci/install-tool.sh --url <tool>
# Keep the trailing pragma: it stops the secret-scan job from flagging the checksum.
terraform 1.13.5 REPLACE_ME  # pragma: allowlist secret
helm 3.19.0 REPLACE_ME  # pragma: allowlist secret
kubeconform 0.7.0 REPLACE_ME  # pragma: allowlist secret
ruff 0.14.5 REPLACE_ME  # pragma: allowlist secret
shellcheck 0.11.0 REPLACE_ME  # pragma: allowlist secret
