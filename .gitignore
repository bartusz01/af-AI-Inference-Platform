# secrets and local state: never commit
# *.tfvars.example does not match *.tfvars, so no negation rule is needed
*.tfvars
*.auto.tfvars
terraform.tfvars.json
backend.hcl
.terraform/
*.tfstate*
# saved plans can contain secret values
*.tfplan
tfplan*
crash.log
override.tf
*_override.tf
override.tf.json
*_override.tf.json
# kubeconfigs belong under .kube/ only; this covers kubeconfig and *-config files there
.kube/
.env*
*.pem
*.key
*.crt
*.log
# .terraform.lock.hcl is deliberately NOT ignored: it must be committed
# benchmark output
harness/results/
# python
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
# macOS
.DS_Store
